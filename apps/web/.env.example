# ============================================================
# VISUCAN ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================

# ===================
# App Configuration
# ===================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================
# Database (Required)
# ===================
# For Vercel, use Vercel Postgres or an external PostgreSQL provider
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visucan

# ===================
# Authentication (Required)
# ===================
# Generate secure secrets: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
PASSWORD_SALT=your-password-salt-change-this

# ===================
# External APIs
# ===================

# Anthropic (Claude AI) - for AI chat features
ANTHROPIC_API_KEY=sk-ant-...

# DigiKey API - for component sourcing
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# PCBWAY API - for PCB manufacturing quotes
PCBWAY_API_KEY=

# ===================
# Stripe (Payments)
# ===================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ===================
# File Storage
# ===================
# Option 1: Vercel Blob (recommended for Vercel)
BLOB_READ_WRITE_TOKEN=

# Option 2: AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=visucan-uploads
AWS_REGION=us-east-1

# ===================
# Email (Optional)
# ===================
# For Vercel, you can use Resend or other email providers
RESEND_API_KEY=
EMAIL_FROM=noreply@visucan.io

# Alternative: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===================
# Redis (Optional)
# ===================
# For caching and rate limiting
# Use Vercel KV or Upstash Redis
REDIS_URL=redis://localhost:6379
# Or for Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===================
# Analytics (Optional)
# ===================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===================
# Vercel Specific
# ===================
# These are automatically set by Vercel
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=your-app.vercel.app
# VERCEL_REGION=iad1
