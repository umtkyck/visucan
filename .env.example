# ============================================================
# VISUCAN ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend URL (for CORS)
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visucan

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production

# External APIs

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-...

# DigiKey API
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# PCBWAY API
PCBWAY_API_KEY=

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=visucan-uploads
AWS_REGION=us-east-1

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@visucan.io
